# Copy this file to .env and replace every example value.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Admin login. Use a strong unique password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-strong-password

# VietQR configuration. Use your own bank/account details.
# BANK_ID may be a supported bank BIN (for example, look up the correct value with your bank/VietQR).
BANK_ID=970436
BANK_ACCOUNT=0123456789
BANK_ACCOUNT_NAME=NGUYEN VAN A

# Optional contact email shown to customers.
SUPPORT_EMAIL=support@example.com
